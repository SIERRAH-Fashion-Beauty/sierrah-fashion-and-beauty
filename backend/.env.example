# SQLite database file (created automatically). Relative paths resolve from the backend folder.
DATABASE_PATH=data/sierrah.db

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Seed the sample wardrobe the first time the database is created (true/false).
SEED_DEMO_DATA=true

# --- Image generation (next development phase) ---------------------------
# Leave IMAGE_PROVIDER=none until a provider is wired up in
# app/services/image_generation.py. The frontend then keeps using curated photos.
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_MODEL=
