# Copy this file to backend/.env and edit the copy. NEVER commit backend/.env.
# Everything here is read by the FastAPI backend only; no secret ever reaches the browser.

# --- Storage ---------------------------------------------------------------
# SQLite database file (created automatically). Relative paths resolve from the backend folder.
DATABASE_PATH=data/sierrah.db
# Folder where generated model images are stored and served from /media. Needs a persistent disk in production.
MEDIA_DIR=data/media
# Seed the sample wardrobe and 4 sample saved looks the first time the database is created (true/false).
SEED_DEMO_DATA=true
# Folder holding the frontend's /images/... files (used only for the optional clothing reference photos).
# Defaults to ../frontend/public when that folder exists.
FRONTEND_PUBLIC_DIR=

# --- Web --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (add your deployed frontend URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- AI model images --------------------------------------------------------
# Providers: gemini (Google Gemini / "Nano Banana") or openai. Leave "none" (or the key empty) and the app
# shows a setup message instead of an image.
#   Gemini key: https://aistudio.google.com/apikey      OpenAI key: https://platform.openai.com/api-keys
# For gemini, GEMINI_API_KEY (or GOOGLE_API_KEY) is also accepted when IMAGE_API_KEY is empty.
IMAGE_PROVIDER=none
IMAGE_API_KEY=
# Optional. Defaults: gemini -> gemini-nano-banana-2.1, openai -> gpt-image-2.5-flare.
IMAGE_MODEL=
# Optional. Override the provider's API base URL (proxy, gateway or a local fake for testing).
IMAGE_API_BASE_URL=
# Gemini output: aspect ratio (e.g. 2:3, 3:4, 9:16) and resolution tier (512 | 1K | 2K | 4K).
IMAGE_ASPECT_RATIO=2:3
IMAGE_RESOLUTION=1K
# OpenAI output: portrait pixel size and quality (low | medium | high | auto). Ignored by gemini.
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium
# Seconds to wait for the provider, retries after 429/5xx/timeouts, and a per-hour cap that protects your bill.
IMAGE_TIMEOUT_SECONDS=150
IMAGE_MAX_RETRIES=1
IMAGE_MAX_PER_HOUR=30
# Optional clothing reference photos (frontend toggle). Count and size caps per request.
IMAGE_MAX_REFERENCE_IMAGES=4
IMAGE_MAX_REFERENCE_BYTES=4000000
